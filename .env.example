# 复制到 sbot/.env 后填写。sbot/.env 已被 .gitignore 忽略,不要提交。

# ---------- 必填 ----------

# BotFather 给的 token
BOT_TOKEN=123456:ABC-DEF...

# 允许使用这个 bot 的 Telegram user id,逗号分隔。不在名单里的消息直接忽略。
ALLOWED_USER_IDS=123456789,987654321

# 所有入库凭据的加密密钥。生成:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意:换掉这个密钥后,已存的密码 / token 都将无法解密。
CRED_ENCRYPTION_KEY=

# ---------- 可选:运行参数 ----------

# SQLite 文件路径,相对路径以 sbot/ 为基准
DB_PATH=./sbot.db

# SSH 连接与命令的默认超时(秒)
SSH_TIMEOUT=15

# 同时处理的 Telegram update 数。装 v2node、发布安装包这类长任务会占用一个槽,
# 设为 1 会让这些操作期间整个 bot 无响应。
MAX_CONCURRENT_UPDATES=4

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- 可选:阿里云 OSS(安装包分发) ----------
# 也可以在 bot 里「📦 安装包分发 → ⚙️ OSS 配置」交互录入;库里的配置优先于这里。

OSS_REGION=cn-hongkong
# 自定义 endpoint,一般不用填
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 绑了 CDN / 自定义域名时填,决定分享出去的下载链接前缀
OSS_PUBLIC_BASE_URL=
# 对象 key 前缀
OSS_PREFIX=releases
