# Telegram bot token(必填)
BOT_TOKEN=

# 授权使用者 user id,多个用逗号分隔(必填)
ALLOWED_USER_IDS=

# 凭据加密密钥(必填)
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENCRYPTION_KEY=

# 可选项
DB_PATH=./sbot.db
SSH_TIMEOUT=15
LOG_LEVEL=INFO

# 阿里云 OSS(安装包分发用)
# 推荐在 bot 内录入:主菜单 → 安装包分发 → ⚙️ OSS 配置(存库并加密)。
# 以下环境变量仅作为未在 bot 内录入时的回退,可不配。
# 区域 id,例如国际站新加坡 ap-southeast-1、香港 cn-hongkong
OSS_REGION=
# bucket 名称(需已创建;分发要求文件可公共读)
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 以下可不填:endpoint 默认 oss-<region>.aliyuncs.com;
# PUBLIC_BASE_URL 用于自定义域名/CDN 场景,例如 https://dl.example.com;
# PREFIX 是上传路径前缀,默认 releases(最终为 releases/<tag>/<文件名>)
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
OSS_PREFIX=
